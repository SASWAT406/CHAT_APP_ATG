# ============================================================
# QuickChat Backend Environment Variables
# ============================================================

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=quickchat_super_secret_jwt_key_2026_change_in_production

# App Download & Web URL
APP_DOWNLOAD_URL=https://github.com/your-username/quickchat/releases/latest

# ------------------------------------------------------------
# 1. Google OAuth 2.0 Configuration (Google Cloud Console)
# ------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------
# 2. Email Notification Configuration (Nodemailer / Gmail / Resend / SMTP)
# ------------------------------------------------------------
# Option A: Gmail (Recommended & Simplest)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_character_google_app_password

# Option B: Standard SMTP (e.g. SendGrid, Mailgun, Brevo, AWS SES)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key
# SMTP_FROM="QuickChat Notifications" <no-reply@yourdomain.com>

# Option C: Resend API (Optional)
# RESEND_API_KEY=re_123456789

# ------------------------------------------------------------
# 3. Persistent MongoDB Database (Optional - defaults to in-memory)
# ------------------------------------------------------------
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickchat?retryWrites=true&w=majority
